{
  "name": "acornvo",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/main.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "pretest": "npm rebuild better-sqlite3",
    "predev": "node scripts/copy-sql-migrations.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -f -w better-sqlite3 && node scripts/copy-vditor-assets.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "notarize:mac": "node scripts/notarize-mac.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.14",
    "@assistant-ui/react-ai-sdk": "^1.3.32",
    "@assistant-ui/react-markdown": "^0.14.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/nunito": "^5.2.7",
    "@langchain/core": "^1.1.48",
    "@langchain/deepseek": "^1.0.27",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.7",
    "@langchain/openrouter": "^0.3.0",
    "@mozilla/readability": "^0.5.0",
    "@node-rs/jieba": "^2.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.15",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-virtual": "^3.13.24",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "heat-graph": "^0.0.10",
    "i18next": "^26.0.7",
    "iconv-lite": "^0.7.2",
    "langchain": "^1.4.2",
    "lucide-react": "^1.17.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "postcss": "^8.5.10",
    "radix-ui": "^1.5.0",
    "react-i18next": "^17.0.4",
    "react-resizable-panels": "^4.11.0",
    "react-router-dom": "^7.14.2",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-shimmer": "^0.4.11",
    "uuid": "^14.0.0",
    "vditor": "^3.11.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "unzipper": "^0.12.3",
    "vite": "^7.2.6",
    "vitest": "^2.1.9"
  }
}
